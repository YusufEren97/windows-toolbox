do {
    Clear-Host
    $ascii = @'
 ________  ______    ______   __        _______    ______   __    __ 
/        |/      \  /      \ /  |      /       \  /      \ /  |  /  |
$$$$$$$$//$$$$$$  |/$$$$$$  |$$ |      $$$$$$$  |/$$$$$$  |$$ |  $$ |
   $$ |  $$ |  $$ |$$ |  $$ |$$ |      $$ |__$$ |$$ |  $$ |$$  \/$$/ 
   $$ |  $$ |  $$ |$$ |  $$ |$$ |      $$    $$< $$ |  $$ | $$  $$<  
   $$ |  $$ |  $$ |$$ |  $$ |$$ |      $$$$$$$  |$$ |  $$ |  $$$$  \ 
   $$ |  $$ \__$$ |$$ \__$$ |$$ |_____ $$ |__$$ |$$ \__$$ | $$ /$$  |
   $$ |  $$    $$/ $$    $$/ $$       |$$    $$/ $$    $$/ $$ |  $$ |
   $$/    $$$$$$/   $$$$$$/  $$$$$$$$/ $$$$$$$/   $$$$$$/  $$/   $$/ 
'@
    
    Write-Host $ascii -ForegroundColor Yellow
    Write-Host "              [ YusufEren97 tarafindan yapildi ]" -ForegroundColor Gray
    Write-Host "  --------------------------------------------------" -ForegroundColor DarkGray
    Write-Host ""
    
    Write-Host "   [1] Port Killer V1.0" -ForegroundColor White
    Write-Host "   [2] Sistem Temizleyici V1.1" -ForegroundColor White
    Write-Host "   [3] Windows/Office Aktivasyon (MAS)" -ForegroundColor Cyan
    Write-Host "   [4] WinUtil - Sistem Optimizasyon (TR)" -ForegroundColor Magenta
    Write-Host "   [5] Office Tool Plus - Office Indirme/Kurulum" -ForegroundColor Blue
    Write-Host "   [6] Cikis" -ForegroundColor Red
    Write-Host ""

    Write-Host "  --------------------------------------------------" -ForegroundColor DarkGray
    $choice = Read-Host "   Seciminiz (1-6)"

    switch ($choice) {
        "1" {
            $path = "$env:temp\portkiller.bat"
            $url = "https://yusuferenseyrek.com.tr/portkiller.bat"
            Write-Host "`n   [+] " -NoNewline -ForegroundColor Green
            Write-Host "Port Killer indiriliyor ve baslatiliyor..." -ForegroundColor Gray
            Invoke-WebRequest $url -OutFile $path
            Start-Process $path -Wait -Verb RunAs
            Write-Host "`n   Islem tamamlandi. Devam etmek icin bir tusa basin..." -ForegroundColor Gray
            $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        "2" {
            $path = "$env:temp\cleaner.bat"
            $url = "https://yusuferenseyrek.com.tr/cleaner.bat"
            Write-Host "`n   [+] " -NoNewline -ForegroundColor Green
            Write-Host "Sistem Temizleyici indiriliyor ve baslatiliyor..." -ForegroundColor Gray
            Invoke-WebRequest $url -OutFile $path
            Start-Process $path -Wait -Verb RunAs
            Write-Host "`n   Islem tamamlandi. Devam etmek icin bir tusa basin..." -ForegroundColor Gray
            $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        "3" {
            Write-Host "`n   [+] " -NoNewline -ForegroundColor Cyan
             Write-Host "Aktivasyon Scripti (MAS) calistiriliyor..." -ForegroundColor Gray
            irm https://get.activated.win | iex
            Write-Host "`n   Menuye donmek icin bir tusa basin..." -ForegroundColor Gray
            $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        "4" {
            Write-Host "`n   [+] " -NoNewline -ForegroundColor Magenta
            Write-Host "WinUtil (Turkce) baslatiliyor..." -ForegroundColor Gray
            irm "https://raw.githubusercontent.com/YusufEren97/WinUtil-Turkish-Edition/main/winutil.ps1" | iex
            Write-Host "`n   Menuye donmek icin bir tusa basin..." -ForegroundColor Gray
            $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        "5" {
            Write-Host "`n   [+] " -NoNewline -ForegroundColor Blue
            Write-Host "Office Tool Plus hazirlaniyor..." -ForegroundColor Gray
            try {
                $arch = if ($env:PROCESSOR_ARCHITECTURE -eq "ARM64") { "arm64" } else { "x64" }
                $rel = Invoke-RestMethod -Uri "https://api.github.com/repos/YerongAI/Office-Tool/releases/latest" -Headers @{ "User-Agent" = "Toolbox" }
                $asset = $rel.assets | Where-Object { $_.name -like "Office_Tool_with_runtime_*_$arch.zip" } | Select-Object -First 1
                if (-not $asset) { throw "Bu mimari icin paket bulunamadi: $arch" }

                $dest = "$env:temp\OfficeToolPlus"
                $zip = "$env:temp\$($asset.name)"
                $exe = Get-ChildItem $dest -Recurse -Filter "Office Tool Plus.exe" -ErrorAction SilentlyContinue | Select-Object -First 1

                if (-not $exe) {
                    Write-Host "   [i] Surum: $($rel.tag_name)  -  Boyut: $([math]::Round($asset.size / 1MB)) MB" -ForegroundColor DarkGray
                    Write-Host "   [i] Indiriliyor, lutfen bekleyin..." -ForegroundColor DarkGray
                    $oldProgress = $ProgressPreference
                    $ProgressPreference = "SilentlyContinue"
                    Invoke-WebRequest $asset.browser_download_url -OutFile $zip
                    $ProgressPreference = $oldProgress
                    if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
                    Expand-Archive -Path $zip -DestinationPath $dest -Force
                    Remove-Item $zip -Force -ErrorAction SilentlyContinue
                    $exe = Get-ChildItem $dest -Recurse -Filter "Office Tool Plus.exe" | Select-Object -First 1
                }
                if (-not $exe) { throw "Office Tool Plus.exe bulunamadi." }

                Write-Host ""
                Write-Host "   [1] Arayuzu ac (onerilen)" -ForegroundColor White
                Write-Host "   [2] Konsol komutu calistir" -ForegroundColor White
                $otpMode = Read-Host "   Seciminiz (1-2)"

                if ($otpMode -eq "2") {
                    $console = Join-Path $exe.DirectoryName "Office Tool Plus.Console.exe"
                    Write-Host "`n   Ornek: deploy /add O365ProPlusRetail_tr-tr /edition 64 /channel Current" -ForegroundColor DarkGray
                    $otpCmd = Read-Host "   Komut"
                    if ([string]::IsNullOrWhiteSpace($otpCmd)) {
                        Write-Host "   [!] Komut girilmedi." -ForegroundColor Red
                    } else {
                        Start-Process $console -ArgumentList $otpCmd -Wait -Verb RunAs
                    }
                } else {
                    Write-Host "`n   [+] Baslatiliyor..." -ForegroundColor Green
                    Start-Process $exe.FullName -Wait -Verb RunAs
                }
            } catch {
                Write-Host "   [!] Hata: $($_.Exception.Message)" -ForegroundColor Red
            }
            Write-Host "`n   Menuye donmek icin bir tusa basin..." -ForegroundColor Gray
            $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        "6" {
            Write-Host "`n   [!] Toolbox sonlandiriliyor..." -ForegroundColor Red
            Start-Sleep -Seconds 1
            break
        }
        Default {
            Write-Host "`n   [!] Hatali secim, tekrar deneyin." -ForegroundColor Red
            Start-Sleep -Seconds 1
        }
    }
} while ($choice -ne "6")
